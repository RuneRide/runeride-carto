CARTO_ENV=local
# Base MariaDB des données OSM (docs/osm/osm_schema.sql). Compte en lecture seule conseillé.
CARTO_DB_DSN="mysql:host=127.0.0.1;port=3307;dbname=runeride_osm;charset=utf8mb4"
CARTO_DB_USER=carto_ro
CARTO_DB_PASSWORD=
# Jeton partagé facultatif (en-tête X-Api-Key). Vide ou absent : pas de contrôle. API interne, voir docs/api.md.
CARTO_API_KEY=
# Durée du cache HTTP des réponses de données, en secondes
CARTO_CACHE_SECONDS=300
