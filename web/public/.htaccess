# Tuiles vectorielles PMTiles (PoC, voir docs/tuiles.md) - NON TESTE sur le vrai Apache d'o2switch.
# Le navigateur lit le fichier par requêtes HTTP Range : il doit être servi tel quel (pas de
# compression, les tuiles sont déjà compressées en interne) avec Accept-Ranges (défaut d'Apache
AddType application/vnd.pmtiles .pmtiles

<IfModule mod_deflate.c>
  SetEnvIfNoCase Request_URI "\.pmtiles$" no-gzip dont-vary
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.pmtiles$">
    Header set Cache-Control "public, max-age=3600"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# o2switch (Apache) : les fichiers existants (tuiles, démo, statiques) sont servis tels quels ;
# tout le reste passe par index.php (API JSON /v1/...). /tuiles/ n'est jamais envoyé vers PHP.
DirectoryIndex index.php
RewriteEngine On

RewriteRule ^tuiles(/|$) - [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]

# Apache/FastCGI retire parfois les en-têtes personnalisés : on transmet X-Api-Key à PHP
RewriteCond %{HTTP:X-Api-Key} .
RewriteRule .* - [E=HTTP_X_API_KEY:%{HTTP:X-Api-Key}]
