{
    "name": "runeride/carto",
    "description": "RuneRide Carto : API interne de données OpenStreetMap (stations, lieux) et tuiles statiques",
    "type": "project",
    "license": "EUPL-1.2",
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "doctrine/dbal": "^4.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": { "psr-4": { "Carto\\": "src/" } },
    "autoload-dev": { "psr-4": { "Carto\\Tests\\": "tests/" } },
    "scripts": { "test": "phpunit", "serve": "php -S 127.0.0.1:8081 -t public" },
    "config": { "optimize-autoloader": true, "sort-packages": true }
}
