#!/usr/bin/env python3
"""Extrait d'un fichier .osm.pbf les stations-service, les localités et le
décompte des adresses, et produit des fichiers TSV (échappement LOAD DATA) plus
`charger.sql`, chargeables en ligne de commande.  Traitement 100 % local : rien
n'est à exécuter sur l'hébergeur.  Calcule aussi `min_zoom` (règles et écrémage
par grille dans carto_osm.py) et la clé de cellule `cell`.

Usage : osm-extraire FICHIER.osm.pbf DOSSIER_SORTIE
Dépendance : pyosmium (pip install osmium), Python >= 3.9.
Sortie : osm_stations.tsv, osm_lieux.tsv, charger.sql, stats.json dans DOSSIER_SORTIE.
Schéma : docs/osm/osm_schema.sql.  Chargement : voir docs/osm.md.

Données © contributeurs OpenStreetMap, licence ODbL (voir docs/osm.md).
Aucun identifiant n'est lu ni écrit par ce script.
"""
import json
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import osmium

import carto_osm

PLACES = {"city", "town", "village", "hamlet", "suburb", "quarter", "neighbourhood"}


def centre(obj, kind):
    if kind == "n":
        return obj.lat, obj.lon
    la = lo = n = 0
    for nd in obj.nodes:
        if nd.location.valid():
            la += nd.location.lat
            lo += nd.location.lon
            n += 1
    return (la / n, lo / n) if n else (None, None)


def entier(v):
    try:
        n = int(str(v).replace(" ", "").split(";")[0])
    except ValueError:
        return None
    return n if 0 <= n <= 2_000_000_000 else None  # colonne INT signée


def main():
    if len(sys.argv) != 3:
        sys.exit(__doc__)
    pbf, sortie = sys.argv[1:]
    os.makedirs(sortie, exist_ok=True)
    t0 = time.time()
    st = {"pbf": os.path.basename(pbf), "pbf_octets": os.path.getsize(pbf),
          "adresses_noeuds": 0, "adresses_chemins": 0}
    stations, lieux = [], []

    fp = osmium.FileProcessor(pbf, osmium.osm.NODE | osmium.osm.WAY) \
        .with_locations() \
        .with_filter(osmium.filter.KeyFilter("amenity", "place", "addr:housenumber"))
    for o in fp:
        kind = "n" if o.is_node() else "w"
        t = o.tags
        if "addr:housenumber" in t and "addr:street" in t:
            st["adresses_noeuds" if kind == "n" else "adresses_chemins"] += 1
        if t.get("amenity") == "fuel":
            la, lo = centre(o, kind)
            if la is None:
                continue
            carb = ",".join(sorted(k[5:] for k, v in ((x.k, x.v) for x in t)
                                   if k.startswith("fuel:") and v == "yes")) or None
            stations.append({"osm_type": kind, "osm_id": o.id, "nom": t.get("name"), "marque": t.get("brand"),
                             "exploitant": t.get("operator"), "carburants": carb,
                             "adr_numero": t.get("addr:housenumber"), "adr_rue": t.get("addr:street"),
                             "adr_cp": t.get("addr:postcode"), "adr_ville": t.get("addr:city"),
                             "lat": la, "lon": lo})
        elif t.get("place") in PLACES and "name" in t and kind == "n":
            lieux.append({"osm_type": kind, "osm_id": o.id, "categorie": t["place"], "nom": t["name"],
                          "nom_alt": t.get("alt_name") or t.get("old_name"),
                          "population": entier(t["population"]) if "population" in t else None,
                          "lat": o.lat, "lon": o.lon})
    t1 = time.time()
    ecr = carto_osm.ecrire(sortie, stations, lieux)
    st.update(stations=len(stations), lieux=len(lieux), duree_filtrage_s=round(t1 - t0, 1),
              duree_zoom_ecriture_s=round(time.time() - t1, 1), **ecr)
    json.dump(st, open(os.path.join(sortie, "stats.json"), "w"), indent=2)
    print(json.dumps(st, indent=2))


main()
